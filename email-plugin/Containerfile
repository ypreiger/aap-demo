# Pulled from registry when building locally. OpenShift BuildConfig sets dockerStrategy.from to
# openshift/python:3.12-ubi9 so cluster builds use the mirrored imagestream (see openshift/buildconfig-binary.yaml).
FROM registry.access.redhat.com/ubi9/python-312:latest

WORKDIR /srv
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app /srv/app
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/srv

USER 1001
EXPOSE 8080

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
